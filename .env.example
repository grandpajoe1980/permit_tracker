# Browser-visible Supabase configuration. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_URL and SUPABASE_ANON_KEY are accepted as local aliases by the probe.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secret. Use the exact environment name below; the Supabase
# Dashboard key label (for example, secret_key_2) is not read automatically.
SUPABASE_SECRET_KEY=
# Legacy compatibility only; migrate away from this name and deactivate the
# old service_role key after all trusted scripts use SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER_API_KEY=

# Public application origin, for example http://localhost:3000 in local development.
APP_BASE_URL=

# Canonical deployment runtime. Use cloudflare only for the explicitly
# supported secondary adapter; Vercel is the default.
PATH_RUNTIME=vercel
