# Browser-visible Supabase configuration. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_URL and SUPABASE_ANON_KEY are accepted as local aliases by the probe.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secrets. Configure these in the deployment secret store.
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER_API_KEY=

# Public application origin, for example http://localhost:3000 in local development.
APP_BASE_URL=
